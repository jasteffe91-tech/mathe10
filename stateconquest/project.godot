; State Conquest – Godot 4.5 Projektdatei

config_version=5

[application]

config/name="State Conquest"
config/description="Werbefreies Echtzeit-Eroberungsspiel"
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.86, 0.93, 0.96, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"
config/quit_on_go_back=false

[autoload]

Config="*res://scripts/autoload/config.gd"
I18n="*res://scripts/autoload/i18n.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"
UpgradeManager="*res://scripts/autoload/upgrade_manager.gd"
LevelManager="*res://scripts/autoload/level_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
UIManager="*res://scripts/autoload/ui_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.86, 0.93, 0.96, 1)
2d/snap/snap_2d_transforms_to_pixel=false
