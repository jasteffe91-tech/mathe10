{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lernlabor-Manifest (Online-Lernlabore 2.0)",
  "type": "object",
  "required": ["id", "version", "title", "tasks"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,2}$" },
    "title": { "type": "string", "minLength": 1 },
    "subject": { "type": "string" },
    "audience": { "type": "string" },
    "tasks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_id", "title", "kind"],
        "properties": {
          "task_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$" },
          "section": { "type": "string" },
          "title": { "type": "string" },
          "kind": { "enum": ["choice", "multi", "text", "number", "simulation", "measurement", "other"] },
          "graded": { "type": "boolean" },
          "counts_for_progress": { "type": "boolean" },
          "options": { "type": "array", "items": { "type": "object", "required": ["value", "label"], "properties": { "value": { "type": "string" }, "label": { "type": "string" } } } },
          "solution": { "type": "object", "required": ["correct"], "properties": { "correct": { "type": "array", "items": { "type": "string" } } } }
        }
      }
    }
  }
}
