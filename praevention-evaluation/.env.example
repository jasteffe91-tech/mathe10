# Beispielkonfiguration – als .env kopieren bzw. beim Hosting als Umgebungsvariablen setzen.
PORT=3000
# Speicherort der SQLite-Datenbank (muss dauerhaft gespeichert/gesichert werden)
DATA_DIR=./data
# Passwort-Hash für den Admin-Bereich (erzeugen mit: npm run set-password -- --print)
ADMIN_PASSWORD_HASH=
# Hinter einem Reverse-Proxy mit HTTPS (Docker/Caddy/Nginx, Uberspace, PaaS):
TRUST_PROXY=1
COOKIE_SECURE=true
