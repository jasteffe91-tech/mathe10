{
  "name": "blitzheld",
  "version": "1.0.0",
  "private": true,
  "description": "Blitzheld – Das Mathe-Abenteuer: Jump-and-Run mit Plus- und Minusaufgaben für die 2. Klasse",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node tools/clean.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:all": "npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
